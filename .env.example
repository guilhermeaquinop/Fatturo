# Copie para .env.local e preencha. Equivale ao .env do Laravel.
# Local: rode `npx supabase start` e use a API URL e a Publishable key que ele mostra
# (ou `npx supabase status`). Nuvem: Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
